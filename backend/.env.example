# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
PORT=5000
# Path to local Python executable (e.g., ./venv/Scripts/python.exe for Windows, ./venv/bin/python for Mac/Linux)
PYTHON_BIN=your_local_python_path_here

# ==============================================================================
# MARIADB CONFIGURATION
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_password_here
DB_NAME=autoparts_dss

# Prisma / SQLAlchemy Connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_local_password_here@127.0.0.1:3306/autoparts_dss"